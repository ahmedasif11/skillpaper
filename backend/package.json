{
  "name": "skillpaper-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts",
    "db:up": "docker compose --project-directory .. up -d mongo",
    "db:down": "docker compose --project-directory .. stop mongo",
    "infra:up": "docker compose --project-directory .. up -d --build",
    "infra:down": "docker compose --project-directory .. down",
    "infra:logs": "docker compose --project-directory .. logs -f",
    "seed": "ts-node src/scripts/seedDatabase.ts",
    "test": "jest --runInBand",
    "test:flow": "node test-flow.js",
    "test:jacqueline": "node test-jacqueline.js",
    "test:muhammad": "node test-muhammad-aamir.js",
    "compare": "node compare-template.js",
    "diagnose": "node diagnose-pdf.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "handlebars": "^4.7.8",
    "ioredis": "^6.0.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "minio": "^8.0.7",
    "mongoose": "^8.0.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.5.0",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.4.3"
  }
}
