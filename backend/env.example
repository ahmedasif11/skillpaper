# Backend Environment Variables
# Copy this file to .env and update the values

# Database
MONGO_URI=mongodb://localhost:27017/skillpaper

# JWT Secret — required, unique, at least 32 characters.
# The app will not start if this is missing, empty, or the placeholder replace_this_in_prod.
JWT_SECRET=change-me-to-a-unique-secret-at-least-32-chars

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Set to 1 only behind a known reverse proxy (honors X-Forwarded-For for rate limits).
TRUST_PROXY=0

# Rate limits (window defaults to 15 minutes)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_PDF_MAX=20
RATE_LIMIT_PDF_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# Required for POST /api/resumes/cleanup (send as X-Cleanup-Token). Authenticated users still need this header.
CLEANUP_TOKEN=change-me-cleanup-token

# Ports & adapters (Phase 1: mock LLM; MinIO/ClamAV/BullMQ for local Docker)
LLM_PROVIDER=mock
STORAGE_PROVIDER=minio
SCANNER_PROVIDER=clamav
QUEUE_PROVIDER=bullmq
EXTRACTOR_PROVIDER=pdf-mammoth

# Gemini (used when LLM_PROVIDER=gemini). If the key is missing, the API falls back to mock parse.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=skillpaper-resumes

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
OPENCV_SERVICE_URL=http://localhost:8001

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
