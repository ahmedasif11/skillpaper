# Backend Environment Variables
# Copy this file to .env and update the values

# Database
MONGO_URI=mongodb://localhost:27017/skillpaper

# JWT Secret — required, unique, at least 32 characters.
# The app will not start if this is missing, empty, or the placeholder replace_this_in_prod.
JWT_SECRET=change-me-to-a-unique-secret-at-least-32-chars

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Set to 1 only behind a known reverse proxy (honors X-Forwarded-For for rate limits).
TRUST_PROXY=0

# Rate limits (window defaults to 15 minutes)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_PDF_MAX=20
RATE_LIMIT_PDF_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# Required for POST /api/resumes/cleanup (send as X-Cleanup-Token). Authenticated users still need this header.
CLEANUP_TOKEN=change-me-cleanup-token
